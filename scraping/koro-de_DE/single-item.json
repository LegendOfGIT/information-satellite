{
  "site": "korodrogerie.de",

  "itemId": "{template.site}-{request.query.itemId}",

  "scraping": [
    {
      "comment": "site",
      "commandId": "set-context-value",
      "parameters": {
        "contextId": "site",
        "value": "koro-de_DE"
      }
    },
    {
      "comment": "link",
      "commandId": "set-context-value",
      "parameters": {
        "contextId": "link",
        "value": "https://{template.site}/{request.query.itemId}"
      }
    },
    {
      "comment": "single-product-view",
      "commandId": "visit-uri",
      "parameters": {
        "contextId": "single-product-view",
        "uri": "{link}"
      }
    },

    {
      "comment": "title",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "title",
        "sourceContextId": "single-product-view",
        "css-queries": [ ".product-detail-name" ]
      }
    },
    {
      "comment": "price-current",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "price-current",
        "sourceContextId": "single-product-view",
        "css-queries": [ ".product-detail-price-container .product-detail-price" ]
      }
    },
    {
      "comment": "price-initial",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "price-initial",
        "sourceContextId": "single-product-view",
        "css-queries": [  ".product-detail-price-container .list-price-price", ".product-detail-price-container .product-detail-price" ]
      }
    },
    {
      "comment": "price-current to float",
      "commandId": "get-float-from-value",
      "parameters": {
        "contextId": "price-current",
        "sourceContextId": "price-current"
      }
    },
    {
      "comment": "price-initial to float",
      "commandId": "get-float-from-value",
      "parameters": {
        "contextId": "price-initial",
        "sourceContextId": "price-initial"
      }
    },

    {
      "comment": "description",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "description",
        "sourceContextId": "single-product-view",
        "separator": " ",
        "css-queries": [
          ".product-detail-description p"
        ]
      }
    },
    {
      "comment": "raw description",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "descriptionRaw",
        "flags": "sg",
        "sourceContextId": "single-product-view",
        "groupIndex": 1,
        "removeTags": false,
        "regex": [
          "<.*?pdp_description__text-expander.*?>((\\n|.)*?)<\\/div"
        ]
      }
    },

    {
      "comment": "description headlines",
      "commandId": "get-values-by-css-queries",
      "parameters": {
        "contextId": "descriptions.headline",
        "sourceContextId": "single-product-view",
        "css-queries": [
          ".product-detail-description h2, .product-detail-description h3"
        ]
      }
    },
    {
      "comment": "description headlines",
      "commandId": "clone-items-and-modify-clones",
      "parameters": {
        "contextId": "descriptions.headline",
        "replacements": {
          "\\s\\s+": " "
        },
        "sourceContextId": "descriptions.headline"
      }
    },
    {
      "comment": "description contents",
      "commandId": "get-values-by-css-queries",
      "parameters": {
        "contextId": "descriptions.content",
        "sourceContextId": "single-product-view",
        "css-queries": [
          ".product-detail-description p"
        ]
      }
    },
    {
      "comment": "descriptions",
      "commandId": "zip-contexts-to-context",
      "parameters": {
        "contextId": "descriptions",
        "exchangeFromWhenEmpty": "headline",
        "exchangeToWhenEmpty": "content",
        "sourceContextIds": [ "descriptions.headline", "descriptions.content" ]
      }
    },


    {
      "comment": "weight in KG",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "weightInKG",
        "sourceContextId": "single-product-view",
        "groupIndex": 2,
        "regex": [
          "<th.*?>Inhalt(\\n|.)*?<td.*?>(.*?)&.*?kg<"
        ]
      }
    },
    {
      "comment": "weight in KG",
      "commandId": "get-float-from-value",
      "parameters": {
        "contextId": "weightInKG",
        "sourceContextId": "weightInKG"
      }
    },
    {
      "comment": "countryOfOrigin",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "countryOfOrigin",
        "sourceContextId": "single-product-view",
        "groupIndex": 4,
        "regex": "<th(\\n|.)*? Herkunft(\\n|.)*?<\\/th>(\\n|.)*?<td.*?>((\\n|.)*?)<\\/td>"
      }
    },
    {
      "comment": "ingredients",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "ingredients",
        "sourceContextId": "single-product-view",
        "groupIndex": 3,
        "regex": " Zutaten(\\n|.)*?<\\/th>(\\n|.)*?<td.*?>((\\n|.)*?)<\\/td>"
      }
    },
    {
      "comment": "important hints",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "importantHints",
        "sourceContextId": "single-product-view",
        "groupIndex": 3,
        "regex": " Kreuzkontamination(\\n|.)*?<\\/th>(\\n|.)*?<td.*?>((\\n|.)*?)<\\/td>"
      }
    },

    {
      "comment": "minimum delivery time in days",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "minimumDeliveryTimeInDays",
        "sourceContextId": "single-product-view",
        "groupIndex": 1,
        "regex": "Lieferzeit:(.*?)-(.*?)Werktage"
      }
    },
    {
      "comment": "minimum delivery time in days to float",
      "commandId": "get-float-from-value",
      "parameters": {
        "contextId": "minimumDeliveryTimeInDays",
        "sourceContextId": "minimumDeliveryTimeInDays"
      }
    },
    {
      "comment": "maximum delivery time in days",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "maximumDeliveryTimeInDays",
        "sourceContextId": "single-product-view",
        "groupIndex": 2,
        "regex": "Lieferzeit:(.*?)-(.*?)Werktage"
      }
    },
    {
      "comment": "maximum delivery time in days to float",
      "commandId": "get-float-from-value",
      "parameters": {
        "contextId": "maximumDeliveryTimeInDays",
        "sourceContextId": "maximumDeliveryTimeInDays"
      }
    },


    {
      "comment": "merchant article number",
      "commandId": "set-context-value",
      "parameters": {
        "contextId": "mean",
        "value": "koro.{request.query.itemId}"
      }
    },

    {
      "comment": "gtin",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "gtin",
        "sourceContextId": "single-product-view",
        "attribute-id": "content",
        "css-queries": [ "meta[itemprop='gtin13']" ]
      }
    },

    {
      "comment": "images-big",
      "commandId": "get-values-by-css-queries",
      "parameters": {
        "contextId": "images-big",
        "sourceContextId": "single-product-view",
        "attribute-id": "src",
        "css-queries": [ ".gallery-slider-thumbnails .splide__list li img" ]
      }
    },
    {
      "comment": "images-big",
      "commandId": "clone-items-and-modify-clones",
      "parameters": {
        "contextId": "images-big",
        "sourceContextId": "images-big",
        "replacements": {
          "w=.*?&": "w=650&",
          "blur=.*?&": "blur=0&",
          "blur=.*?$": "blur=0"
        }
      }
    },

    {
      "comment": "add small versions of images-big",
      "commandId": "clone-items-and-modify-clones",
      "parameters": {
        "contextId": "images-small",
        "sourceContextId": "images-big",
        "replacements": {
          "w=650": "w=150"
        }
      }
    },
    {
      "comment": "title-image",
      "commandId": "get-value-from-array",
      "parameters": {
        "contextId": "title-image",
        "sourceContextId": "images-big"
      }
    },

    {
      "comment": "number of ratings",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "numberOfRatings",
        "sourceContextId": "single-product-view",
        "attribute-id": "content",
        "css-queries": [ "meta[itemprop='ratingCount']" ]
      }
    },
    {
      "comment": "number of ratings",
      "commandId": "get-float-from-value",
      "parameters": {
        "contextId": "numberOfRatings",
        "defaultValue": 0,
        "sourceContextId": "numberOfRatings"
      }
    },

    {
      "comment": "rating",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "ratingInPercent",
        "sourceContextId": "single-product-view",
        "attribute-id": "content",
        "css-queries": [ "meta[itemprop='ratingValue']" ]
      }
    },
    {
      "comment": "rating",
      "commandId": "get-float-from-value",
      "parameters": {
        "contextId": "ratingInPercent",
        "defaultValue": 0,
        "sourceContextId": "ratingInPercent"
      }
    },
    {
      "comment": "rating",
      "commandId": "get-rule-of-three-value",
      "parameters": {
        "maximumValue": 5,
        "contextId": "ratingInPercent"
      }
    },

    {
      "comment": "brand",
      "commandId": "get-value-by-css-queries",
      "parameters": {
        "contextId": "brand",
        "attribute-id": "content",
        "sourceContextId": "single-product-view",
        "css-queries": [ "meta[property='product:brand']" ]
      }
    },

    {
      "comment": "is vegan",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "isVegan",
        "sourceContextId": "single-product-view",
        "flags": "gi",
        "defaultValue": false,
        "setValueOnMiss": false,
        "setValueOnMatch": true,
        "regex": [
          "(sind|ist|als) vegan"
        ]
      }
    },

    {
      "comment": "teaser texts",
      "commandId": "get-values-by-css-queries",
      "parameters": {
        "contextId": "teaser-texts",
        "sourceContextId": "single-product-view",
        "css-queries": [ ".koro-buying-arguments-text" ]
      }
    },

    {
      "comment": "amount in stock",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "amountInStock",
        "sourceContextId": "single-product-view",
        "setValueOnMatch": 0,
        "setValueOnMiss": 999,
        "regex": "OutOfStock"
      }
    },

    {
      "comment": "seoKeywords",
      "commandId": "extract-seo-keywords",
      "parameters": {
        "contextId": "seoKeywords",
        "sourceContextId": ["description", "title"]
      }
    },

    {
      "comment": "removeProviderFlag",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "removeProviderFlag",
        "sourceContextId": "single-product-view",
        "setValueOnMatch": true,
        "setValueOnMiss": false,
        "regex": "Wir konnten die Seite, die du aufrufen wolltest, leider nicht finden."
      }
    },
    {
      "comment": "remove provider when product can not be found anymore",
      "commandId": "remove-provider",
      "parameters": {
        "flagId": "removeProviderFlag"
      }
    },

    {
      "comment": "storeProviderFlag",
      "commandId": "get-value-by-regex",
      "parameters": {
        "contextId": "storeProviderFlag",
        "sourceContextId": "single-product-view",
        "setValueOnMatch": false,
        "setValueOnMiss": true,
        "regex": "Wir konnten die Seite, die du aufrufen wolltest, leider nicht finden."
      }
    },

    {
      "comment": "store scraped information",
      "commandId": "store-information",
      "parameters": {
        "flagId": "storeProviderFlag",
        "informationIds": [
          "amountInStock",
          "brand",
          "countryOfOrigin",
          "description",
          "descriptions",
          "descriptions.headline",
          "gtin",
          "images-big",
          "images-small",
          "importantHints",
          "ingredients",
          "isVegan",
          "link",
          "maximumDeliveryTimeInDays",
          "mean",
          "minimumDeliveryTimeInDays",
          "numberOfRatings",
          "price-current",
          "price-initial",
          "ratingInPercent",
          "seoKeywords",
          "teaser-texts",
          "title",
          "title-image",
          "weightInKG"
        ]
      }
    }
  ]
}
